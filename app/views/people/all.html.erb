<h1>
  <% if @total_found != 1 %>
    <%= "#{@total_found} people" %><%= " start with letter #{params[:letter]}" if params[:letter] %>
  <% else %>
    <%= "#{@total_found} person" %><%= " starts with letter #{params[:letter]}" if params[:letter] %>
  <% end %>
</h1>

<div class="main_alpha_menu">
<%= make_alphabet_menu(@alphabet) %>
</div>

<div class="pagination_container">
  <h2 class="sr-only" id="pagination_label">Pagination</h2>
  <nav aria-labelledby="pagination_label">
    <%= paginator(@total_pages) %>
  </nav>
</div>

<ul>
  <% @docs[:docs].each do |person| %>
    <% if linkable_id?(person["id"]) %>
      <li><%= link_to(person["title"], person_path(person["id"])) %></li>
    <% end %>
  <% end %>
</ul>

<div class="pagination_container">
  <h2 class="sr-only" id="bottom_pagination_label">Bottom Pagination</h2>
  <nav aria-labelledby="bottom_pagination_label">
    <%= paginator(@total_pages) %>
  </nav>
</div>
